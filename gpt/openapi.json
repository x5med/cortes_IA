  "components": {
    "schemas": {
      "Body_uploadVideo": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_uploadVideo"
      },
      "Brief": {
        "properties": {
          "audience": {
            "type": "string",
            "maxLength": 1000,
            "title": "Audience",
            "default": "Pessoas interessadas no tema da live"
          },
          "goal": {
            "type": "string",
            "enum": [
              "alcance",
              "autoridade",
              "conversao",
              "comunidade"
            ],
            "title": "Goal",
            "default": "alcance"
          },
          "platform": {
            "type": "string",
            "enum": [
              "shorts",
              "reels",
              "tiktok"
            ],
            "title": "Platform",
            "default": "shorts"
          },
          "min_duration": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 5.0,
            "title": "Min Duration",
            "default": 20
          },
          "max_duration": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 5.0,
            "title": "Max Duration",
            "default": 60
          },
          "count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Count",
            "default": 5
          },
          "mode": {
            "type": "string",
            "enum": [
              "codex",
              "demo"
            ],
            "title": "Mode",
            "default": "codex"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Brief"
      },
      "Feedback": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "aprovado",
              "rejeitado"
            ],
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          },
          "platform": {
            "type": "string",
            "enum": [
              "shorts",
              "reels",
              "tiktok"
            ],
            "title": "Platform",
            "default": "shorts"
          },
          "views": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Views"
          },
          "stayed_to_watch": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stayed To Watch"
          },
          "average_percentage_viewed": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Percentage Viewed"
          },
          "shares": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Shares"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RenderRequest": {
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "original",
              "vertical_fit",
              "vertical_crop"
            ],
            "title": "Format",
            "default": "vertical_crop"
          },
          "subtitles": {
            "type": "boolean",
            "title": "Subtitles",
            "default": false
          },
          "crop_x": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Crop X",
            "default": 0.5
          },
          "follow_face": {
            "type": "boolean",
            "title": "Follow Face",
            "default": true
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RenderRequest"
      },
      "Segment": {
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "End"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/Word"
            },
            "type": "array",
            "title": "Words"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "title": "Segment"
      },
      "TranscriptRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title",
            "default": "Minha live"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "maxItems": 20000,
            "minItems": 1,
            "title": "Segments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "segments"
        ],
        "title": "TranscriptRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Word": {
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "minimum": 0.0,
            "title": "End"
          },
          "word": {
            "type": "string",
            "title": "Word"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "word"
        ],
        "title": "Word"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ]
}
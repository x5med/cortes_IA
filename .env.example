# Não usa API OpenAI paga. Entre no Codex com sua conta ChatGPT.
CORTES_CODEX_PATH=
CORTES_WHISPER_MODEL=small
# Vazio: detectar idioma automaticamente.
CORTES_LANGUAGE=
# Vocabulário opcional para melhorar nomes/termos na transcrição.
CORTES_ASR_GLOSSARY=
# Obrigatório para expor a API fora de localhost. Use uma chave aleatória forte.
CORTES_API_TOKEN=
CORTES_PUBLIC_URL=http://127.0.0.1:8000
